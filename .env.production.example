DJANGO_SECRET_KEY=BU-YERGA-YANGI-KALIT
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=jaloliddin-mushtariy.uz,www.jaloliddin-mushtariy.uz
CSRF_TRUSTED_ORIGINS=https://jaloliddin-mushtariy.uz,https://www.jaloliddin-mushtariy.uz

# QR kodlar va mehmon havolalari shu manzil asosida quriladi.
# https bilan yozing — QR kodni chop etgandan keyin tuzatib bo'lmaydi.
SITE_URL=https://jaloliddin-mushtariy.uz

# ---- Baza ----
# 1 GB RAM'da PostgreSQL o'ziga 300 MB oladi — bu bizga qimmat.
# SQLite bir necha yuz mehmonlik to'y sayti uchun to'liq yetarli
# va zaxira nusxa olish osonroq: bitta fayl.
DB_ENGINE=sqlite

TIME_ZONE=Asia/Tashkent

# ---- Yuklash chegaralari ----
# 20 GB disk uchun 150 MB. Bu 2-3 daqiqalik telefon videosi.
# Bu raqam Caddyfile'dagi max_size dan KICHIK bo'lishi shart.
MAX_UPLOAD_SIZE_MB=150
MAX_UPLOADS_PER_GUEST=40
PRIVATE_MEDIA_ROOT=

# ---- Limitlar ----
# To'y kuni yuzlab mehmon bir vaqtda kiradi.
THROTTLE_ANON=600/hour
THROTTLE_UPLOAD=300/hour
THROTTLE_RSVP=60/hour
LOG_LEVEL=INFO

CORS_ALLOWED_ORIGINS=